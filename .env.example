# Environment Variables

# 1. Contact Form (EmailJS)
# Make sure to replace these with your real EmailJS credentials if using email notifications directly
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# 2. Google Analytics 4
# Create a Google Analytics account, set up a property, and get the Measurement ID (G-XXXXXXXXXX)
VITE_GA_ID=G-XXXXXXXXXX

# 3. WhatsApp Business
# Your WhatsApp phone number in international format (without +, spaces, or dashes)
# Example: for +20 123 456 7890 → write 201234567890
VITE_WHATSAPP_NUMBER=201043971900

# 4. Firebase Configuration
# Go to https://console.firebase.google.com/
# Create a Project -> Add Web App -> Copy the keys here
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
